# Copy this file to .env and fill in your own key(s). Never commit .env.

LLM_PROVIDER=anthropic
# "anthropic" or "groq". Only the matching API key below is required -- see README's
# "LLM provider" section for the tradeoff (Groq is far cheaper; Anthropic is the
# better-verified default for this app's structured-output-dependent calls).

ANTHROPIC_API_KEY=
# REQUIRED when LLM_PROVIDER=anthropic -- get your own key at https://console.anthropic.com.
CLAUDE_MODEL=claude-sonnet-5
# Cheaper alternative: claude-haiku-4-5. Sonnet is the default because the Cleaning Agent
# generates and executes pandas code and the Audit Agent produces a report users may share
# externally -- both are correctness-sensitive enough to be worth the extra cost by default.

GROQ_API_KEY=
# REQUIRED when LLM_PROVIDER=groq -- get your own key at https://console.groq.com.
GROQ_MODEL=llama-3.3-70b-versatile

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_SECONDS=86400

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

UPLOAD_RETENTION_SECONDS=86400
# How long uploaded CSVs, cleaned copies and audit reports are kept on disk. Matches
# REDIS_TTL_SECONDS by default so files expire alongside the session state that refers to
# them. Set to 0 to keep everything indefinitely -- useful while debugging one session,
# but it means the user's data stays on your disk forever.
CLEANUP_INTERVAL_SECONDS=3600

REQUIRE_SESSION_TOKENS=
# Leave blank to follow APP_ENV: off in development, on everywhere else. When on, the token
# handed back by /api/upload must be sent as X-Session-Token on every request scoped to that
# session, so knowing a session id is no longer enough to read the data behind it. The web UI
# does this for itself. Turn it off in development only -- on a hosted instance it is the
# whole security model.

CHROMA_PERSIST_DIR=./chroma_db
# Reserved, currently unused -- see README's scope notes on why ChromaDB isn't wired up yet.

APP_ENV=development
LOG_LEVEL=INFO

VITE_API_BASE_URL=http://localhost:8000
