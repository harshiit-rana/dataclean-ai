# Copy this file to .env and fill in your own key. Never commit .env.
ANTHROPIC_API_KEY=
# REQUIRED -- get your own key at https://console.anthropic.com. There is no default/shared
# key; the app will refuse to start Claude calls without one.

CLAUDE_MODEL=claude-sonnet-5
# Cheaper alternative: claude-haiku-4-5. Sonnet is the default because the Cleaning Agent
# generates and executes pandas code and the Audit Agent produces a report users may share
# externally -- both are correctness-sensitive enough to be worth the extra cost by default.

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_SECONDS=86400

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

CHROMA_PERSIST_DIR=./chroma_db
# Reserved, currently unused -- see README's scope notes on why ChromaDB isn't wired up yet.

APP_ENV=development
LOG_LEVEL=INFO

VITE_API_BASE_URL=http://localhost:8000
