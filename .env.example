# Copy this file to .env and fill in your own key(s). Never commit .env.

LLM_PROVIDER=anthropic
# "anthropic" or "groq". Only the matching API key below is required -- see README's
# "LLM provider" section for the tradeoff (Groq is far cheaper; Anthropic is the
# better-verified default for this app's structured-output-dependent calls).

ANTHROPIC_API_KEY=
# REQUIRED when LLM_PROVIDER=anthropic -- get your own key at https://console.anthropic.com.
CLAUDE_MODEL=claude-sonnet-5
# Cheaper alternative: claude-haiku-4-5. Sonnet is the default because the Cleaning Agent
# generates and executes pandas code and the Audit Agent produces a report users may share
# externally -- both are correctness-sensitive enough to be worth the extra cost by default.

GROQ_API_KEY=
# REQUIRED when LLM_PROVIDER=groq -- get your own key at https://console.groq.com.
GROQ_MODEL=llama-3.3-70b-versatile

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_SECONDS=86400

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_COLUMNS=1000
MAX_ROWS=2000000
MAX_CELL_CHARS=32767
# Bounds on a file's shape, not only its bytes: a 50 MB file can still hold hundreds of thousands of columns or one
# enormous cell, enough to exhaust memory. Each upload is refused with a message naming the limit it crossed.

TRAINING_COST_LIMIT=30000000
# The most work one training request may be estimated to do, in "row-fits": one row fitted by the cheapest
# model counts as one, a forest as 40, boosted trees as 25. Past it the request is reduced instead of left to
# run for as long as it takes: model choice uses a sample of the training rows, then the most expensive
# families are skipped, then the request is refused with a message saying what would fit. Whatever was
# reduced is stated in the result and on the model card. The default lets a file of about a hundred thousand
# rows through unreduced. 0 turns the limit off.

MAX_STORED_RUNS=10
# Trained models kept per session, each with its fitted pipeline, so an earlier one can be compared or brought
# back. The oldest beyond this are pruned; the one in use never is. A fitted forest can be tens of megabytes.

UPLOAD_RETENTION_SECONDS=86400
# How long uploaded CSVs, cleaned copies and audit reports are kept on disk. Matches
# REDIS_TTL_SECONDS by default so files expire alongside the session state that refers to
# them. Set to 0 to keep everything indefinitely -- useful while debugging one session,
# but it means the user's data stays on your disk forever.
CLEANUP_INTERVAL_SECONDS=3600

REQUIRE_SESSION_TOKENS=
# Leave blank to follow APP_ENV: off only when APP_ENV=development, on otherwise -- including when APP_ENV is
# not set at all. When on, the token
# handed back by /api/upload must be sent as X-Session-Token on every request scoped to that
# session, so knowing a session id is no longer enough to read the data behind it. The web UI
# does this for itself. Turn it off in development only -- on a hosted instance it is the
# whole security model.

CHROMA_PERSIST_DIR=./chroma_db
# Reserved, currently unused -- see README's scope notes on why ChromaDB isn't wired up yet.

APP_ENV=development
# development: session tokens off and error details echoed to the browser, for running locally. Remove it (or set
# production) on any hosted instance -- unset means production, with tokens required.
LOG_LEVEL=INFO

VITE_API_BASE_URL=http://localhost:8000
